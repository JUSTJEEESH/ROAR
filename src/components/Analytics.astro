---
import { site } from '../config/site';
const a = site.analytics;
---

<!-- Off unless site.analytics.enabled. Plausible only for now; no cookies, no personal data. -->
{
  a.enabled && a.provider === 'plausible' && (
    <>
      <script is:inline defer data-domain={a.domain} src="https://plausible.io/js/script.js" />
      <script is:inline>
        {`
        window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
        var send = function (name) { window.plausible(name); };
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-analytics]');
          if (el && el.dataset.analytics !== 'faq_open') send(el.dataset.analytics);
        });
        document.addEventListener('toggle', function (e) {
          if (e.target.open && e.target.dataset && e.target.dataset.analytics === 'faq_open') send('faq_open');
        }, true);
        document.addEventListener('submit', function (e) {
          if (e.target.dataset && e.target.dataset.analytics) send(e.target.dataset.analytics);
        });
        `}
      </script>
    </>
  )
}
