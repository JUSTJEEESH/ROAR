---
import { t } from '../../i18n/utils';
import { resolveFaq } from '../../i18n/faq';
import type { FaqId, Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  ids: FaqId[];
}
const { locale, ids } = Astro.props;
const items = resolveFaq(locale, ids);
const note = t(locale).pages.faq.pendingNote;
---

<!-- Native <details>/<summary>: keyboard and screen-reader accessible without JS. -->
{
  items.length > 0 && (
    <div class="faq">
      {items.map((i) => (
        <details class="faq__item" data-analytics="faq_open" data-faq-id={i.id}>
          <summary>
            <span>{i.q}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path class="v" d="M12 4v16" stroke="currentColor" stroke-width="2.5" fill="none" />
              <path d="M4 12h16" stroke="currentColor" stroke-width="2.5" fill="none" />
            </svg>
          </summary>
          <div class="faq__answer">
            {i.pending ? <p class="faq__pending">{note}</p> : <p>{i.a}</p>}
          </div>
        </details>
      ))}
    </div>
  )
}

<style>
  .faq {
    border-top: 3px solid var(--color-primary);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-block: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex: none;
  }
  details[open] summary .v {
    display: none;
  }
  .faq__answer {
    padding-bottom: var(--space-6);
    max-width: var(--measure);
  }
  .faq__pending {
    padding: var(--space-3);
    border: 2px dashed var(--color-line);
    color: var(--color-muted);
    font-weight: 600;
  }
</style>
