---
import { localizedPath, t } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  /** External link from site.links. Empty string = unconfirmed. */
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  onDark?: boolean;
  block?: boolean;
  analytics?: string;
}
const { locale, href, variant = 'primary', onDark, block = true, analytics } = Astro.props;
const c = t(locale);
---

<!-- Renders the button, and when the link isn't confirmed yet, an honest note plus a way to reach ROAR. -->
<div class="link-cta">
  <Button
    href={href || undefined}
    variant={variant}
    onDark={onDark}
    block={block}
    unconfirmedLabel={c.cta.unconfirmedLink}
    data-analytics={analytics}
  >
    <slot />
  </Button>
  {
    !href && (
      <p class="link-cta__note">
        {c.pages.cta.unavailable} <a href={localizedPath(locale, '/contact')}>{c.pages.cta.unavailableContact}</a>
      </p>
    )
  }
</div>

<style>
  .link-cta {
    display: grid;
    gap: var(--space-2);
  }
  .link-cta__note {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .link-cta__note a {
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
  }
</style>
