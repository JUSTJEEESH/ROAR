---
import { Picture } from 'astro:assets';
import { site } from '../../config/site';
import type { Locale } from '../../i18n/types';

interface Props {
  /** Key in site.photos */
  name: keyof typeof site.photos;
  locale: Locale;
  /** Visible label for the placeholder block (shown only until a real photo is configured) */
  placeholder: string;
  /** Above the fold / LCP image: eager + high priority. Everything else lazy. */
  priority?: boolean;
  sizes: string;
}
const { name, locale, placeholder, priority = false, sizes } = Astro.props;

// Fills its parent. The parent sets the aspect ratio.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const spec = site.photos[name];
const img = spec ? files[`/src/assets/photos/${spec.file}`]?.default : undefined;
if (spec && !img) {
  throw new Error(`site.photos.${name}: src/assets/photos/${spec.file} not found`);
}
---

{
  spec && img ? (
    <Picture
      src={img}
      alt={spec.alt[locale]}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1440, 1920]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class="photo"
    />
  ) : (
    <div class="photo-placeholder photo-fill" role="img" aria-label={placeholder}>
      {placeholder}
    </div>
  )
}

<style>
  .photo-fill {
    width: 100%;
    height: 100%;
  }
  :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(picture:has(> .photo)) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
