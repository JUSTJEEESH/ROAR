---
import { site } from '../../config/site';
import { t } from '../../i18n/utils';
import type { ContactTopic, Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const f = t(locale).pages.contact.form;
const disconnected = !site.contact.formspreeId;
const action = disconnected ? undefined : `https://formspree.io/f/${site.contact.formspreeId}`;
const topics = Object.keys(f.topics) as ContactTopic[];
---

<form
  class="cform"
  method="POST"
  action={action}
  data-analytics="contact_form_submit"
  data-success={f.success}
  data-error={f.error}
  data-sending={f.sending}
>
  <fieldset disabled={disconnected}>
    <div class="field">
      <label for="cf-name">{f.name} <span class="req">({f.required})</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-err" />
      <p id="cf-name-err" class="err" role="alert"></p>
    </div>
    <div class="field">
      <label for="cf-email">{f.email} <span class="req">({f.required})</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-err" />
      <p id="cf-email-err" class="err" role="alert"></p>
    </div>
    <div class="field">
      <label for="cf-topic">{f.topic}</label>
      <select id="cf-topic" name="topic">
        {topics.map((k) => <option value={k}>{f.topics[k]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="cf-subject">{f.subject}</label>
      <input id="cf-subject" name="subject" type="text" />
    </div>
    <div class="field">
      <label for="cf-message">{f.message} <span class="req">({f.required})</span></label>
      <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-err"></textarea>
      <p id="cf-message-err" class="err" role="alert"></p>
    </div>
    <!-- Honeypot: hidden from people and assistive tech; bots fill it in -->
    <div class="hp" aria-hidden="true">
      <label>Leave blank<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <button type="submit" class="submit">{f.submit}</button>
  </fieldset>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('.cform');
  if (form && form.action) {
    form.noValidate = true; // we show accessible inline errors instead of browser bubbles
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    const label = btn.textContent;

    const fields = () =>
      Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));
    const showError = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const err = document.getElementById(el.getAttribute('aria-describedby') ?? '');
      const bad = !el.checkValidity();
      el.setAttribute('aria-invalid', String(bad));
      if (err) err.textContent = bad ? el.validationMessage : '';
      return bad;
    };
    fields().forEach((el) => el.addEventListener('blur', () => showError(el)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields().filter(showError);
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      status.textContent = form.dataset.sending ?? '';
      btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.success ?? '';
      } catch {
        status.textContent = form.dataset.error ?? '';
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>

<style>
  .cform fieldset {
    display: grid;
    gap: var(--space-4);
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .field {
    display: grid;
    gap: var(--space-2);
  }
  label {
    font-weight: 800;
  }
  .req {
    font-weight: 500;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: var(--touch);
    padding: 0.625rem 0.75rem;
    background: var(--color-surface);
    border: 2px solid var(--color-muted);
    border-radius: var(--radius);
  }
  textarea {
    resize: vertical;
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--color-accent);
  }
  .err {
    min-height: 0;
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .hp {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    min-height: var(--touch);
    padding: 0.75rem 1.25rem;
    background: var(--color-accent);
    color: #fff;
    border: 2px solid transparent;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: var(--text-base);
    cursor: pointer;
  }
  .submit:hover {
    background: var(--color-accent-hover);
  }
  .submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .status {
    margin-top: var(--space-3);
    font-weight: 700;
  }
  fieldset:disabled {
    opacity: 0.6;
  }
  @media (min-width: 48em) {
    .submit {
      justify-self: start;
    }
  }
</style>
