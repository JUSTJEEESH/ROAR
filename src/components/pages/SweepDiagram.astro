---
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const steps = t(locale).pages.strategy.sweep.steps;

const cx = 160, cy = 160, r = 115, n = steps.length;
const at = (i: number) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a), a };
};
// Arc between consecutive nodes, stopping short of each node so the arrowhead is visible.
const gap = 0.2;
const arcs = steps.map((_, i) => {
  const a0 = at(i).a + gap;
  const a1 = at(i + 1).a - gap + (i === n - 1 ? 2 * Math.PI : 0);
  const p0 = { x: cx + r * Math.cos(a0), y: cy + r * Math.sin(a0) };
  const p1 = { x: cx + r * Math.cos(a1), y: cy + r * Math.sin(a1) };
  return `M${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A${r} ${r} 0 0 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
});
---

<svg class="sweep" viewBox="0 0 320 320" aria-hidden="true" focusable="false">
  <defs>
    <marker id="sweep-ah" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
      <path d="M0 0L10 5L0 10z" class="head" />
    </marker>
  </defs>
  {arcs.map((d) => <path d={d} class="ring" marker-end="url(#sweep-ah)" />)}
  {
    steps.map((_, i) => {
      const p = at(i);
      return (
        <g>
          <circle cx={p.x} cy={p.y} r="22" class="node" />
          <text x={p.x} y={p.y + 8} text-anchor="middle" class="num">{i + 1}</text>
        </g>
      );
    })
  }
</svg>

<style>
  .sweep {
    width: 100%;
    max-width: 22rem;
  }
  .ring {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
  }
  .head {
    fill: var(--color-accent);
  }
  .node {
    fill: var(--color-primary);
  }
  .num {
    fill: var(--color-on-primary);
    font-size: 22px;
    font-weight: 800;
  }
</style>
