---
import { unconfirmedFields } from '../config/site';
import { es } from '../i18n/es';

const fields = unconfirmedFields();
if (!es.reviewed) fields.push('i18n/es: Spanish copy not native-reviewed (docs/SPANISH_REVIEW.md)');
---

{
  import.meta.env.DEV && fields.length > 0 && (
    <details class="dev-banner">
      <summary>Dev: {fields.length} unconfirmed</summary>
      <ul>{fields.map((f) => <li>{f}</li>)}</ul>
    </details>
  )
}

<style>
  .dev-banner {
    position: fixed;
    inset-block-start: 0;
    inset-inline-end: 0;
    z-index: 200;
    max-width: 20rem;
    max-height: 60vh;
    overflow: auto;
    padding: 0.25rem 0.5rem;
    background: #111;
    color: #fff;
    font: 12px/1.4 monospace;
    opacity: 0.85;
  }
  .dev-banner summary {
    cursor: pointer;
  }
</style>
