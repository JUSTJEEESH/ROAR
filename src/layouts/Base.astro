---
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/global.css';
import DevBanner from '../components/DevBanner.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import Seo from '../components/seo/Seo.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}
const { title, description, locale } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b3b5c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} locale={locale} pathname={pathname} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale).a11y.skipToContent}</a>
    <Header locale={locale} pathname={pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <StickyCta locale={locale} />
    <DevBanner />
  </body>
</html>
