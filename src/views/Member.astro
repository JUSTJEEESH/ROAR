---
import Base from '../layouts/Base.astro';
import FaqList from '../components/ui/FaqList.astro';
import LinkCta from '../components/ui/LinkCta.astro';
import NextAction from '../components/ui/NextAction.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../config/site';
import { copyVars, resolveFaq } from '../i18n/faq';
import { fmt, localizedPath, t } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);
const p = c.pages.member;
const vars = copyVars(locale);
const fm = site.foundingMembers;
const meta = c.pages.meta.member;
const faqVisible = resolveFaq(locale, p.faqIds).length > 0;
---

<Base title={fmt(meta.title, vars)} description={meta.description} locale={locale}>
  <PageHero title={fmt(p.title, vars)} subtitle={p.subtitle}>
    <div class="offer" data-hides-sticky>
      <p class="eyebrow">{p.priceHeading}</p>
      <div class="offer__prices">
        <p class="price">
          <span class="price__amt">{vars.monthly}</span>
          <span class="price__unit">{c.home.founding.perMonth}</span>
          <span class="price__note">{fmt(c.home.founding.forMonths, vars)}</span>
        </p>
        <p class="offer__or">{c.home.founding.or}</p>
        <p class="price">
          <span class="price__amt">{vars.annual}</span>
          <span class="price__unit">{c.home.founding.perYear}</span>
        </p>
      </div>
      <div class="offer__cta">
        <LinkCta locale={locale} href={site.links.membership} analytics="membership_cta_click">
          {c.cta.founding}
        </LinkCta>
      </div>
    </div>
  </PageHero>

  <section class="section alt" aria-labelledby="funds-title">
    <div class="container two">
      <div>
        <h2 id="funds-title" class="section-title">{p.fundsHeading}</h2>
        <ul role="list" class="rows">
          {p.funds.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="section-title">{p.benefitsHeading}</h2>
        <ul role="list" class="rows">
          {fm.benefits.map((k) => <li>{c.benefits[k]}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="updates-title">
    <div class="container stack">
      <h2 id="updates-title" class="section-title">{p.updatesHeading}</h2>
      <p class="lede">{p.updates}</p>
    </div>
  </section>

  {
    faqVisible && (
      <section class="section" aria-labelledby="mfaq-title">
        <div class="container stack">
          <h2 id="mfaq-title" class="section-title">{p.faqHeading}</h2>
          <FaqList locale={locale} ids={p.faqIds} />
        </div>
      </section>
    )
  }

  <NextAction
    locale={locale}
    title={c.pages.next.member.title}
    text={c.pages.next.member.text}
    actions={[
      { href: localizedPath(locale, '/contact'), label: c.cta.contactRoar },
      { href: localizedPath(locale, '/the-strategy'), label: c.cta.exploreStrategy, variant: 'secondary' },
    ]}
  />
</Base>

<style>
  .offer {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    max-width: 30rem;
  }
  .offer__prices {
    display: grid;
    gap: var(--space-2);
  }
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
  }
  .price__amt {
    font-size: var(--text-hero);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-primary);
  }
  .price__unit {
    font-size: var(--text-lg);
    font-weight: 800;
    text-transform: uppercase;
  }
  .price__note {
    flex-basis: 100%;
    color: var(--color-muted);
  }
  .offer__or {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .alt {
    background: var(--color-alt);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
  }
  .rows {
    margin-top: var(--space-4);
    border-top: 3px solid var(--color-primary);
  }
  .rows li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  @media (min-width: 48em) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-16);
    }
  }
</style>
