# Security and cache headers. Read by both Cloudflare Pages and Netlify.
# If analytics stay off, plausible.io can be removed from script-src and connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://plausible.io; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io https://plausible.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Hashed build output never changes under the same name
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social images can change when copy or the logo changes
/og/*
  Cache-Control: public, max-age=86400
